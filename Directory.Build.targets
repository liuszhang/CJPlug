<Project>
  <!--
    自动将 Utf8ConsoleInit.cs 注入所有 Exe 项目（AppHost、ApiServer、DispatchServer 等）
    [ModuleInitializer] 在 Main() 之前执行，确保 Console.Out 创建时已经是 UTF-8 编码

    <ItemGroup Condition="'$(OutputType)' == 'Exe' AND '$(MSBuildProjectExtension)' == '.csproj'">
    <Compile Include="$(MSBuildThisFileDirectory)01.Scripts\Utf8ConsoleInit.cs" Link="Utf8ConsoleInit.cs" />
  </ItemGroup>
  -->

  <!--
    共享输出目录 - 程序集解析兜底：
    当多个服务输出到同一目录时，各自的 .deps.json 会互相覆盖，
    导致未被最后构建的服务的 NuGet 依赖无法定位。
    此文件注册 AppDomain.AssemblyResolve 事件，从共享目录直接加载 DLL。
    对所有共享输出目录的服务项目生效（Services）。
  -->
  <ItemGroup Condition="'$(BaseOutputPath)' != '' And $(BaseOutputPath.Contains('Services')) And Exists('$(MSBuildThisFileDirectory)SharedAssemblyResolve.cs')">
    <Compile Include="$(MSBuildThisFileDirectory)SharedAssemblyResolve.cs"
             Link="SharedAssemblyResolve.cs" />
  </ItemGroup>

  <!--
    共享输出目录配置复制（2026-10-30「配置归一」后**白名单化**）：
    当多个服务输出到同一目录时，各自的 appsettings.json 会互相覆盖。
    此 Target 将项目的 appsettings.json 额外复制一份为 appsettings.{项目名}.json，
    供 AppHost 通过 ASPNETCORE_CONFIG_PATH 环境变量为该服务指定独立的配置文件。

    ⚠ 归一后**只有仍是独立进程的项目才需要专属文件**：
      · 主服务 CJPlug.Server —— 不需要。它的配置已归一为执行目录下的 appsettings.json
        （由该项目自带、CopyToOutputDirectory=Always 保证胜出）。再生成 appsettings.CJPlug.Server.json
        只是多一份同内容文件，反而容易被改错、被误当成"真正生效的那份"。
      · CJ.Plug.ApiServer / DispatchServer / McpServer / HostWebServer —— 不需要。
        它们已降级为类库、没有自己的进程，专属文件是纯冗余；留着会让人以为还有独立服务在跑，
        （历史上正是这些文件的存在掩盖了"根 appsettings.json 被覆盖 ⇒ 主服务连错库且无报错"）。
      · CJ.Plug.StationApiServer（工位机，7660）—— **需要**，是目前唯一在白名单里的。

    ⚠ 新增独立进程服务时，把项目名加进下面的白名单；降级为类库时记得移出。
  -->
  <Target Name="CopyAppSettingsWithProjectName"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\appsettings.json') And '$(MSBuildProjectName)' == 'CJ.Plug.StationApiServer'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\appsettings.json"
          DestinationFiles="$(OutputPath)appsettings.$(MSBuildProjectName).json"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    工位机专属配置的 **publish 侧孪生**（2026-10-31《CJPlug 打包按 CJOntology 口径重设计》§5.2-2 / R3）。

    为什么必须有：上面那条挂的是 `AfterTargets="Build"`、落点 `$(OutputPath)`。`dotnet publish` 收的是
    ResolvedFileToPublish，自定义 target 直接往输出目录拷的文件**不会进发布目录** ⇒ 按 publish 产出的
    工位机载荷会缺 appsettings.CJ.Plug.StationApiServer.json，清单的 verify-entry 当场回滚整台安装。
  -->
  <Target Name="CopyAppSettingsWithProjectNameOnPublish"
          AfterTargets="Publish"
          Condition="Exists('$(MSBuildProjectDirectory)\appsettings.json') And '$(MSBuildProjectName)' == 'CJ.Plug.StationApiServer' And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_StationCfgPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_StationCfgPublishDir>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\appsettings.json"
          DestinationFiles="$(_StationCfgPublishDir)appsettings.$(MSBuildProjectName).json"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    共享输出目录**主配置**复制（2026-10-30 配置归一）：
    唯一可执行宿主的 appsettings.json 落成执行目录下的 appsettings.json。

    ⚠ 为什么不用 <Content CopyToOutputDirectory="Always">（更直觉的写法）：
      Content 复制的文件会被 `IncrementalClean` 当作「本项目的输出」写进
      obj/<配置>/<项目>.csproj.FileListAbsolute.txt；一旦**另一个**项目（如工位机）
      曾经复制过同名文件、后来改为不复制，它重新构建时 IncrementalClean 会把
      「上一轮由我写出、这一轮不再写」的 appsettings.json 删掉 —— 实测直接把主服务的
      配置删空（构建后目录里只剩 appsettings.Development.json）。
      走 Target 复制不进 FileList，任何项目重新构建都不会动它。
    ⚠ SkipUnchangedFiles=false：主配置必须每次以项目内的版本为准（现场改坏的配置会被构建纠正）。
  -->
  <Target Name="CopySharedRootAppSettings"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'CJPlug.Server' And Exists('$(MSBuildProjectDirectory)\appsettings.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\appsettings.json"
          DestinationFiles="$(OutputPath)appsettings.json"
          SkipUnchangedFiles="false" />
  </Target>

  <!--
    主服务配置的 **publish 侧孪生**（2026-10-31《CJPlug 打包按 CJOntology 口径重设计》§5.2-3 / R1）。

    ⚠ 这是本组改造里**后果最重**的一条：CJPlug.Server.csproj 把 appsettings.json 标了
      `CopyToOutputDirectory=Never`（避免被 IncrementalClean 当成本项目输出），若不在这里补，
      `dotnet publish` 出的宿主目录里**根本没有 appsettings.json** ⇒ 服务照常启动、但连接串/
      InternalApi/三员种子密码全部回落默认值，连错库且无任何报错（历史上正是这个静默坏法）。
  -->
  <Target Name="CopySharedRootAppSettingsOnPublish"
          AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'CJPlug.Server' And Exists('$(MSBuildProjectDirectory)\appsettings.json') And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_RootCfgPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_RootCfgPublishDir>
    </PropertyGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\appsettings.json"
          DestinationFiles="$(_RootCfgPublishDir)appsettings.json"
          SkipUnchangedFiles="false" />
  </Target>

  <!--
    共享输出目录 - NuGet DLL 版本冲突防护：
    OllamaSharp.ModelContextProtocol 传递依赖 ModelContextProtocol.Core 0.2.0.0，
    而 McpServer 的 ModelContextProtocol.AspNetCore 1.4.0 需要 Core 1.4.0.0。
    多服务共享同一输出目录时，后构建的项目可能用旧版覆盖新版。
    此 Target 阻止非 McpServer 项目复制 ModelContextProtocol.* DLL，
    由 McpServer 独占复制正确版本到共享目录。
  -->
  <Target Name="ExcludeModelContextProtocolFromCopy"
          AfterTargets="ResolveReferences"
          Condition="'$(MSBuildProjectName)' != 'CJ.Plug.McpServer'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('ModelContextProtocol'))" />
    </ItemGroup>
  </Target>

  <!--
    IL Trimming 保护（当前未启用，配合 Directory.Build.props 中 trimming 设置使用）：
    以下库不兼容 trimming（大量使用反射/动态加载），
    未来启用 trimming 时取消注释以强制保留全部代码。

    <ItemGroup Condition="'$(Configuration)' == 'Release' And '$(OutputType)' == 'Exe'">
      <TrimmerRootAssembly Include="Aspose.Words" />
      <TrimmerRootAssembly Include="Aspose.Slides" />
      <TrimmerRootAssembly Include="Aspose.Cells" />
      <TrimmerRootAssembly Include="DocumentFormat.OpenXml" />
      <TrimmerRootAssembly Include="BouncyCastle.Cryptography" />
      <TrimmerRootAssembly Include="Newtonsoft.Json" />
      <TrimmerRootAssembly Include="MudBlazor" />
      <TrimmerRootAssembly Include="Radzen.Blazor" />
    </ItemGroup>
  -->

</Project>
