<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CJ.Plug.Models</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <VersionPrefix>1.0.3</VersionPrefix>
	  <PackageOutputPath>..\..\..\04.Nuget</PackageOutputPath>
	  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Crane.MethodHook" />
    <PackageReference Include="EventAggregator.Blazor" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
	  <PackageReference Include="System.Linq.Async" />
  </ItemGroup>

  <!--
    CJCore 模块契约（2026-10-29 接入 P1 / D2=A1）：
    本项目的 IModule / ModuleBase 收敛到 CJCore，26 个模块子类因此无需逐个改动。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\CJCore\src\Framework\CJCore.Framework.Abstractions\CJCore.Framework.Abstractions.csproj" />
    <!--
      P4（2026-10-29）：业务表迁入 CJCore Data 底座。
      只在本项目加一句引用，18 个模块项目靠 ProjectReference 的传递性拿到 DataDbContext / IModuleDbConfig，
      从而不必逐个改 csproj。CJCore.Modules.Data.Model 已自带 Data.Shared（接口所在项目）。
    -->
    <ProjectReference Include="..\..\..\..\CJCore\src\Modules\Data\CJCore.Modules.Data.Model\CJCore.Modules.Data.Model.csproj" />
  </ItemGroup>

</Project>
