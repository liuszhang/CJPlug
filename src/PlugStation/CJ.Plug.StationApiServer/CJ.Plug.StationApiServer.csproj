<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CJ.Plug.StationApiService</RootNamespace>
    <BaseOutputPath>..\..\..\02.Publish\Services</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AgentApi\**" />
    <Compile Remove="StationLogs\**" />
    <Content Remove="AgentApi\**" />
    <Content Remove="StationLogs\**" />
    <EmbeddedResource Remove="AgentApi\**" />
    <EmbeddedResource Remove="StationLogs\**" />
    <None Remove="AgentApi\**" />
    <None Remove="StationLogs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client.Core" />
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- UltraVNC portable 文件 (winvnc.exe, VNCHooks.dll) -->
  <ItemGroup>
    <Content Include="uvnc-portable\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CJ.Plug.ApiClient\CJ.Plug.ApiClient.csproj" />
    <ProjectReference Include="..\..\..\..\CJCore\src\Framework\CJCore.AspireHost.ServiceDefaults\CJCore.AspireHost.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\modules\CJ.Plug.ModuleConfig\CJ.Plug.ModuleConfig.csproj" />
    <ProjectReference Include="..\..\modules\FileManageModule\CJ.Plug.FileManageApiClient\CJ.Plug.FileManageApiClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="D:\Pro\CJ.Plug-Aspire\01.Scripts\Utf8ConsoleInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="D:\Pro\CJ.Plug-Aspire\01.Scripts\Utf8ConsoleInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配置归一（2026-10-30）：共享输出目录里的 appsettings.json 归**唯一宿主 CJPlug.Server 独有**，
      本项目不再往那里写同名文件 —— 否则谁赢由构建顺序决定（历史上主服务因此连错 ../../main.db
      且无任何报错）。工位机是独立进程（7660），它自己的配置走专属文件名
      appsettings.CJ.Plug.StationApiServer.json，由 Directory.Build.targets 的
      CopyAppSettingsWithProjectName 目标生成（AppHost 按 dll 名推导正好命中该文件）。
    -->
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
