<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>..\..\..\02.Publish\Services</BaseOutputPath>
    <!-- P9.1（2026-10-30，D2 = B）：降级为类库，不再产出 exe（旧的独立进程形态是 3001 端口）。
         现在 MCP 面由 CJPlug.Server 经 MapMcp("/mcp") 挂在 **5066** 上，路径由根路径 "/" 改为 "/mcp"。
         Tools/ 与 Services/ 下的源码全部保留并被宿主引用；
         删掉的只有旧启动壳 Program.cs（内容已逐条核对，无遗漏）。
         ⚠ 外部 MCP 客户端（Cursor / Trae）配置应改为 http://<host>:5066/mcp。 -->
    <OutputType>Library</OutputType>
	  <!-- 添加此属性以控制是否跳过构建 -->
	  <!--<SkipBuild Condition="'$(SkipBuild)' == 'true'">true</SkipBuild>-->
	  <!--<SkipBuild>true</SkipBuild>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配置归一（2026-10-30）：本项目是类库，MCP 面的运行期配置由唯一宿主 CJPlug.Server 的
         appsettings.json 提供。不再把自己的 appsettings.json 复制到共享输出目录 —— 否则会与
         宿主的同名文件互相覆盖（构建顺序决定谁赢，历史上曾导致主服务连错库且无任何报错）。
         回退为独立进程时把这段恢复，并改用专属文件名 appsettings.CJ.Plug.McpServer.json。 -->
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CJ.Plug.Models\CJ.Plug.Models.csproj" />
    <ProjectReference Include="..\..\..\..\CJCore\src\Framework\CJCore.AspireHost.ServiceDefaults\CJCore.AspireHost.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
