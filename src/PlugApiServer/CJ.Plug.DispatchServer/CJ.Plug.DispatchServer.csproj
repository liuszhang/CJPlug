<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>..\..\..\02.Publish\Services</BaseOutputPath>
    <!-- P9.1（2026-10-30，D2 = B「回退形态一次全删」）：本项目降级为**类库**，不再产出 exe。
         唯一宿主是 CJPlug.Server（5066），调度面由它经 AddDispatchApiService() /
         MapDispatchServiceEndpoints() 挂载。本项目源码（MainHub / DispatcherApi /
         StationService）被 CJPlug.Server 直接 ProjectReference，全部保留；
         删掉的只有旧启动壳 Program.cs —— 其内容已逐条核对并被宿主覆盖，无遗漏。 -->
    <OutputType>Library</OutputType>
	  <!-- 添加此属性以控制是否跳过构建 -->
	  <!--<SkipBuild Condition="'$(SkipBuild)' == 'true'">true</SkipBuild>-->
	  <SkipBuild>true</SkipBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配置归一（2026-10-30）：上面 Phase 5 的注释只写了意图、并没有真正生效（缺这一段），
         实测共享输出目录里的 appsettings.json 仍是本项目的内容。这里显式关掉复制 ——
         本项目已是类库，调度面的运行期配置由唯一宿主 CJPlug.Server 的 appsettings.json 提供。
         回退为独立进程时把这段恢复，并改用专属文件名 appsettings.CJ.Plug.DispatchServer.json。 -->
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <!-- 2026-10-31：publish 侧同样关掉（CopyToOutputDirectory 管不到 publish 清单），
           否则宿主图里 5 个项目发布同名 appsettings.json 会 NETSDK1152 直接失败。 -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 2026-10-29《CJPlug 服务架构简化》Phase 5：本项目已降级为被 ApiServer 引用的类库，
       不再把自己的 appsettings.json 复制进共享输出目录 —— 否则会与 ApiServer 的配置互相覆盖
       （所有服务共用 02.Publish/Services/{Config}/net10.0，构建顺序决定谁赢）。
       回退独立部署时把这段恢复。 -->

	<ItemGroup>
		<!-- 复制当前 .csproj 文件到输出目录 -->
		<None Include="$(MSBuildProjectFile)">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Core\CJ.Plug.Models\CJ.Plug.Models.csproj" />
	  <ProjectReference Include="..\..\..\..\CJCore\src\Framework\CJCore.AspireHost.ServiceDefaults\CJCore.AspireHost.ServiceDefaults.csproj" />
	</ItemGroup>

</Project>
