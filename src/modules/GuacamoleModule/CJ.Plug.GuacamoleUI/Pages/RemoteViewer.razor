@page "/remote/{StationIp}"
@page "/remote/{StationIp}/{Protocol}"

@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

@inject NavigationManager NavigationManager

<PageTitle>@($"远程访问 - {StationIp}")</PageTitle>

@* 根据协议类型重定向到对应的查看器 *@

@code {
    [Parameter]
    public string StationIp { get; set; } = default!;

    [Parameter]
    public string? Protocol { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int? Port { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Username { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Password { get; set; }

    protected override void OnInitialized()
    {
        var protocol = Protocol?.ToLower() ?? "ssh";
        var queryParams = new List<string>();

        if (Port.HasValue)
            queryParams.Add($"port={Port.Value}");
        if (!string.IsNullOrEmpty(Username))
            queryParams.Add($"username={Uri.EscapeDataString(Username)}");
        if (!string.IsNullOrEmpty(Password))
            queryParams.Add($"password={Uri.EscapeDataString(Password)}");
        if (!string.IsNullOrEmpty(Username))
            queryParams.Add("autoConnect=true");

        var queryString = queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "";

        // 统一提取纯主机名（stationIp 可能是 "http://192.168.161.237:7660" 完整地址）
        var pureHost = ExtractHost(StationIp);

        var targetUrl = protocol switch
        {
            // 单窗口 RFB VNC：连图站 5901（RfbWindowVncServer）
            "window" => $"/remote/vnc/{pureHost}?port=5901&window=1",
            "vnc" or "rdp" => $"/remote/vnc/{pureHost}{queryString}",
            "ssh" => $"/remote/ssh/{pureHost}{queryString}",
            _ => $"/remote/vnc/{pureHost}{queryString}"
        };

        NavigationManager.NavigateTo(targetUrl, replace: true);
    }

    /// <summary>
    /// 从可能的完整 URL 中提取纯 IP/主机名（与 PlugExecuteStandalone.ExtractHost 一致）。
    /// </summary>
    private static string ExtractHost(string? raw)
    {
        if (string.IsNullOrEmpty(raw))
            return "localhost";

        if (Uri.TryCreate(raw, UriKind.Absolute, out var uri))
            return uri.Host;

        var stripped = raw;
        if (stripped.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            stripped = stripped[7..];
        else if (stripped.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            stripped = stripped[8..];

        var colonIdx = stripped.IndexOf(':');
        if (colonIdx > 0)
            stripped = stripped[..colonIdx];

        return stripped;
    }
}
