@page "/SystemConfig"
@using CJ.Plug.SystemConfigApiClient
@using CJ.Plug.SystemConfigModel.Models
@inject ISystemConfigApiClient SystemConfigApiClient
@inject ISnackbar Snackbar

<PageTitle>系统配置</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h5">系统配置</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate Class="mt-4" />
    }
    else
    {
        <MudCard Class="mt-4">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="mb-2">远程查看模式</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: #888;">
                    控制工具执行时远程桌面的查看方式：整桌面（全屏）或单窗口（仅投射程序窗体）
                </MudText>
                <MudSelect T="string"
                           @bind-Value="_remoteViewMode"
                           Label="远程查看模式"
                           Variant="Variant.Outlined"
                           Class="mb-4"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value='@("fullscreen")'>整桌面 VNC（默认，全部屏幕）</MudSelectItem>
                    <MudSelectItem Value='@("window")'>单窗口 RFB VNC（仅投射程序窗体）</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="@SaveRemoteViewModeAsync"
                           Disabled="@_saving"
                           StartIcon="@Icons.Material.Filled.Save">
                    @(_saving ? "保存中..." : "保存")
                </MudButton>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    private const string RemoteViewModeKey = "RemoteViewMode";

    private bool _loading = true;
    private bool _saving;
    private string _remoteViewMode = "fullscreen";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var value = await SystemConfigApiClient.GetValueAsync(RemoteViewModeKey);
            if (!string.IsNullOrEmpty(value))
                _remoteViewMode = value;
        }
        catch
        {
            // 首次运行可能表未初始化，保持默认值
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveRemoteViewModeAsync()
    {
        _saving = true;
        try
        {
            await SystemConfigApiClient.SetValueAsync(
                RemoteViewModeKey,
                _remoteViewMode,
                "远程查看模式：fullscreen=整桌面 VNC（默认），window=单窗口 RFB VNC 投射");
            Snackbar.Add($"远程查看模式已保存：{_remoteViewMode}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
